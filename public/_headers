# Cloudflare Pages 헤더 규칙.
# /calendar.ics 는 functions/calendar.ics.js 가 직접 헤더를 붙이므로 여기 없다.
# (정적 파일을 두면 Function 보다 우선해서 낡은 파일이 나간다)

/schedule.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# ESM 모듈. 잘못된 Content-Type 으로 나가면 브라우저가 모듈을 거부해
# 대시보드가 통째로 안 뜬다.
/lib/*
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=300
